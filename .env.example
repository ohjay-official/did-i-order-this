# Firebase web config (client keys). Do not put an App Check debug token here.
# Debug tokens must never be committed or shipped in a production or preview bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Production / registered hostname only. Leave empty until the reCAPTCHA key is registered.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
