{
  "manifest_version": 3,
  "name": "Did I Order This?",
  "version": "0.1.0",
  "description": "Check a delivery email against the purchases and tracking numbers on this device.",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Did I Order This?"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
